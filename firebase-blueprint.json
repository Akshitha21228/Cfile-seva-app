{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account details and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth ID" },
        "displayName": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "photoURL": { "type": "string", "format": "uri", "description": "Profile picture URL" },
        "phoneNumber": { "type": "string", "description": "Contact number" },
        "location": { "type": "string", "description": "User location" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "Order": {
      "title": "Service Order",
      "description": "Details of a service purchased by a user.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Unique order ID" },
        "userId": { "type": "string", "description": "ID of the user who placed the order" },
        "serviceIds": { "type": "array", "items": { "type": "string" }, "description": "List of service IDs in the order" },
        "totalAmount": { "type": "number", "description": "Total amount paid" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "cancelled"], "description": "Order status" },
        "paymentId": { "type": "string", "description": "Payment gateway reference" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Order placement timestamp" }
      },
      "required": ["orderId", "userId", "serviceIds", "totalAmount", "status", "createdAt"]
    },
    "Cart": {
      "title": "User Cart",
      "description": "Items currently in the user's shopping cart.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the cart owner" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "quantity": { "type": "integer" }
            }
          }
        },
        "fullItems": { "type": "array", "items": { "type": "object" }, "description": "Full service details for offline access" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "fullItems"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Service orders placed by users."
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "User shopping carts for cross-device sync."
    }
  }
}
